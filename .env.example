# Separate server-to-server credential for RMIS to create tickets for its signed-in users.
RMIS_TICKET_API_KEY="replace-with-another-separate-32-character-random-secret"
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
